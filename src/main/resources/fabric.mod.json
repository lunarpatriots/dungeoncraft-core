{
  "schemaVersion": 1,
  "id": "dungeoncraft-core",
  "version": "${version}",
  "name": "DungeonCraft Core",
  "description": "Core mod that adds custom functionalities to DungeonCraft modpacks",
  "authors": [
    {
    "name": "lunarpatriots"
    }
  ],
  "contact": {
    "homepage": "https://github.com/lunarpatriots/dungeoncraft-core",
    "issues": "https://github.com/lunarpatriots/dungeoncraft-core/issues"
  },
  "license": "GPLv3",
  "icon": "assets/dungeoncraft/icon.png",
  "environment": "*",
  "custom": {
    "modmenu": {
      "links": {
        "Github": "https://github.com/lunarpatriots/dungeoncraft-core",
        "Curseforge": "https://curseforge.com/minecraft/mc-mods/dungeoncraft-core",
        "Modrinth": "https://modrinth.com/mod/dungeoncraft-core"

      }
    }
  },
  "entrypoints": {
    "fabric-datagen": [
      "com.lunarpatriots.dungeoncraft.client.DungeonCraftDataGenerator"
    ],
    "client": [
      "com.lunarpatriots.dungeoncraft.client.DungeonCraftClient"
    ],
    "main": [
      "com.lunarpatriots.dungeoncraft.DungeonCraft"
    ],
    "modmenu": [
      "com.lunarpatriots.dungeoncraft.client.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "dungeoncraft.mixins.json",
    {
      "config": "dungeoncraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "cloth-config": ">=${cloth_config_version}"
  }
}
