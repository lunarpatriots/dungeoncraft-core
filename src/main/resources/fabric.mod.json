{
  "schemaVersion": 1,
  "id": "server-auth",
  "version": "${version}",
  "name": "dungeoncraft",
  "description": "Core mod that adds custom functionalities to DungeonCraft modpacks",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/dungeoncraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.lunarpatriots.dungeoncraft.client.DungeonCraftDataGenerator"
    ],
    "client": [
      "com.lunarpatriots.dungeoncraft.client.DungeonCraftClient"
    ],
    "main": [
      "com.lunarpatriots.dungeoncraft.DungeonCraft"
    ]
  },
  "mixins": [
    "dungeoncraft.mixins.json",
    {
      "config": "dungeoncraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
